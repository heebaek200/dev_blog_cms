{{>layout/header}}
<section class="login-panel mx-auto p-4 p-md-5" aria-labelledby="login-title">
    <p class="text-uppercase small fw-semibold mb-2 text-secondary">Administrator</p>
    <h1 id="login-title" class="h2 mb-2">관리자 로그인</h1>
    <p class="text-secondary mb-4">콘텐츠를 관리하려면 로그인하세요.</p>

    {{>components/messages}}

    <form action="/admin/login" method="post" novalidate>
        <div class="mb-3">
            <label class="form-label" for="username">아이디</label>
            <input class="form-control{{#hasUsernameError}} is-invalid{{/hasUsernameError}}"
                   id="username"
                   name="username"
                   value="{{loginRequest.username}}"
                   autocomplete="username"
                   aria-describedby="username-error"
                   required>
            {{#hasUsernameError}}
            <div class="invalid-feedback" id="username-error">{{usernameError}}</div>
            {{/hasUsernameError}}
        </div>

        <div class="mb-4">
            <label class="form-label" for="password">비밀번호</label>
            <input class="form-control{{#hasPasswordError}} is-invalid{{/hasPasswordError}}"
                   id="password"
                   name="password"
                   type="password"
                   autocomplete="current-password"
                   aria-describedby="password-error"
                   required>
            {{#hasPasswordError}}
            <div class="invalid-feedback" id="password-error">{{passwordError}}</div>
            {{/hasPasswordError}}
        </div>

        <button class="btn app-btn-primary w-100" type="submit">로그인</button>
    </form>
    <a class="btn btn-link w-100 mt-3" href="/">블로그로 돌아가기</a>
</section>
{{>layout/footer}}
