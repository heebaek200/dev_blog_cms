{{>layout/header}}
<div class="public-reading-shell">
    <header class="mb-5">
        <p class="text-uppercase small fw-semibold mb-2 text-secondary">Developer Blog</p>
        <h1 class="display-5 fw-bold">배운 것을 짧고 분명하게 기록합니다.</h1>
        <p class="lead text-secondary mb-0">Spring Boot와 웹 개발 과정에서 발견한 문제와 해결 방법을 정리합니다.</p>
    </header>

    <section id="categories" class="mb-4" aria-labelledby="category-filter-title">
        <h2 id="category-filter-title" class="h6">카테고리</h2>
        <div class="d-flex flex-wrap gap-2">
            <a class="taxonomy-chip{{#list.allSelected}} taxonomy-chip-selected{{/list.allSelected}}" href="/">전체</a>
            {{#list.categories}}
            <a class="taxonomy-chip{{#selected}} taxonomy-chip-selected{{/selected}}" href="{{url}}">{{name}}</a>
            {{/list.categories}}
        </div>
    </section>

    <section id="tags" class="mb-5" aria-labelledby="tag-filter-title">
        <h2 id="tag-filter-title" class="h6">태그</h2>
        <div class="d-flex flex-wrap gap-2">
            {{#list.tags}}
            <a class="tag-chip{{#selected}} tag-chip-selected{{/selected}}" href="{{url}}">{{name}}</a>
            {{/list.tags}}
            {{^list.tags}}<span class="small text-secondary">등록된 태그가 없습니다.</span>{{/list.tags}}
        </div>
    </section>

    <section aria-labelledby="public-post-list-title">
        <div class="d-flex align-items-end justify-content-between gap-3 mb-3">
            <div>
                <p class="text-uppercase small fw-semibold mb-1 text-secondary">{{list.listLabel}}</p>
                <h2 id="public-post-list-title" class="h3 mb-0">{{list.listTitle}}</h2>
            </div>
            <span class="text-secondary text-nowrap">{{list.postCountLabel}}</span>
        </div>

        {{#list.hasPosts}}
        <div class="d-grid gap-3">
            {{#list.posts}}
            <article class="public-surface public-post-card">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    {{#category}}<a class="taxonomy-chip" href="{{url}}">{{name}}</a>{{/category}}
                    {{^category}}<span class="taxonomy-chip taxonomy-chip-static">미분류</span>{{/category}}
                    <span class="text-secondary small">{{createdAt}}</span>
                </div>
                <h3 class="h4 mb-3"><a class="public-post-link" href="/posts/{{id}}">{{title}}</a></h3>
                {{#hasTags}}
                <div class="d-flex flex-wrap gap-2" aria-label="게시글 태그">
                    {{#tags}}<a class="tag-chip" href="{{url}}">#{{name}}</a>{{/tags}}
                </div>
                {{/hasTags}}
            </article>
            {{/list.posts}}
        </div>
        {{/list.hasPosts}}

        {{^list.hasPosts}}
        <div class="public-surface public-empty-state text-center">
            <h3 class="h5">{{list.emptyTitle}}</h3>
            <p class="text-secondary mb-3">{{list.emptyDescription}}</p>
            <a class="btn btn-outline-secondary" href="/">전체 글 보기</a>
        </div>
        {{/list.hasPosts}}
    </section>
</div>
{{>layout/footer}}
